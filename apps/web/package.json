{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "VITE_API_URL=http://localhost:3000 bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "VITE_API_URL=http://localhost:3000 bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
